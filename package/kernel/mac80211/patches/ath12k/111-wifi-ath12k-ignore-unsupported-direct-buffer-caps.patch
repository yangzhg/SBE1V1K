From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] wifi: ath12k: ignore unsupported direct buffer caps

Newer firmware may advertise optional direct-buffer modules unknown to the
host driver.  Rejecting one unknown module currently discards every parsed
direct-buffer capability and aborts the surrounding service-ready TLV
parse.

Skip capabilities for unsupported module IDs while retaining known ones.
Do not expose placeholder entries for skipped modules, and free the array
when no usable capabilities remain.

---
 drivers/net/wireless/ath/ath12k/wmi.c | 37 ++++++++++++++++++++++-------------
 1 file changed, 22 insertions(+), 15 deletions(-)

--- a/drivers/net/wireless/ath/ath12k/wmi.c
+++ b/drivers/net/wireless/ath/ath12k/wmi.c
@@ -4687,8 +4687,8 @@ static int ath12k_wmi_dma_ring_caps(stru
 	struct ath12k_wmi_dma_ring_caps_parse *dma_caps_parse = data;
 	struct ath12k_wmi_dma_ring_caps_params *dma_caps;
 	struct ath12k_dbring_cap *dir_buff_caps;
+	u32 i, module_id, num_valid_caps = 0;
 	int ret;
-	u32 i;
 
 	dma_caps_parse->n_dma_ring_caps = 0;
 	dma_caps = (struct ath12k_wmi_dma_ring_caps_params *)ptr;
@@ -4714,26 +4714,33 @@ static int ath12k_wmi_dma_ring_caps(stru
 
 	dir_buff_caps = ab->db_caps;
 	for (i = 0; i < dma_caps_parse->n_dma_ring_caps; i++) {
-		if (le32_to_cpu(dma_caps[i].module_id) >= WMI_DIRECT_BUF_MAX) {
-			ath12k_warn(ab, "Invalid module id %d\n",
-				    le32_to_cpu(dma_caps[i].module_id));
-			ret = -EINVAL;
-			goto free_dir_buff;
+		module_id = le32_to_cpu(dma_caps[i].module_id);
+		if (module_id >= WMI_DIRECT_BUF_MAX) {
+			ath12k_warn(ab,
+				    "ignoring unsupported direct buffer module id %u\n",
+				    module_id);
+			continue;
 		}
 
-		dir_buff_caps[i].id = le32_to_cpu(dma_caps[i].module_id);
-		dir_buff_caps[i].pdev_id =
+		dir_buff_caps[num_valid_caps].id = module_id;
+		dir_buff_caps[num_valid_caps].pdev_id =
 			DP_HW2SW_MACID(le32_to_cpu(dma_caps[i].pdev_id));
-		dir_buff_caps[i].min_elem = le32_to_cpu(dma_caps[i].min_elem);
-		dir_buff_caps[i].min_buf_sz = le32_to_cpu(dma_caps[i].min_buf_sz);
-		dir_buff_caps[i].min_buf_align = le32_to_cpu(dma_caps[i].min_buf_align);
+		dir_buff_caps[num_valid_caps].min_elem =
+			le32_to_cpu(dma_caps[i].min_elem);
+		dir_buff_caps[num_valid_caps].min_buf_sz =
+			le32_to_cpu(dma_caps[i].min_buf_sz);
+		dir_buff_caps[num_valid_caps].min_buf_align =
+			le32_to_cpu(dma_caps[i].min_buf_align);
+		num_valid_caps++;
 	}
 
-	return 0;
+	if (!num_valid_caps) {
+		ath12k_wmi_free_dbring_caps(ab);
+		return 0;
+	}
 
-free_dir_buff:
-	ath12k_wmi_free_dbring_caps(ab);
-	return ret;
+	ab->num_db_cap = num_valid_caps;
+	return 0;
 }
 
 static void
