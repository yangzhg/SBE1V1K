CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq95xx=y
CONFIG_TARGET_qualcommbe_ipq95xx_DEVICE_askey_sbe1v1k=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# Do not build the host-side GDB toolchain unless a developer explicitly asks
# for it; it is not installed in the image and adds substantial cold-build time.
# CONFIG_GDB is not set

# LuCI over HTTPS, package management, and Simplified Chinese
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_LUCI_LANG_zh_Hans=y

# Dynamic DNS
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_ddns-scripts-aliyun=y
CONFIG_PACKAGE_ddns-scripts-dnspod=y
CONFIG_PACKAGE_ddns-scripts-dnspod-v3=y

# PassWall and the proxy engines shipped by the reference firmware
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_shadowsocks-rust-sslocal=y
CONFIG_PACKAGE_shadowsocks-rust-ssserver=y
CONFIG_PACKAGE_v2ray-plugin=y
CONFIG_PACKAGE_haproxy=y
CONFIG_PACKAGE_geoview=y
CONFIG_PACKAGE_simple-obfs-client=y
CONFIG_PACKAGE_ipt2socks=y

# Complete TLS/download tooling. curl supports SOCKS and Unix sockets;
# GNU Wget replaces the BusyBox applet and provides HTTPS/proxy support.
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_LIBCURL_OPENSSL=y
# CONFIG_LIBCURL_MBEDTLS is not set
CONFIG_LIBCURL_HTTP=y
CONFIG_LIBCURL_HTTP2=y
CONFIG_LIBCURL_PROXY=y
CONFIG_LIBCURL_UNIX_SOCKETS=y
CONFIG_LIBCURL_COOKIES=y
CONFIG_LIBCURL_HTTP_AUTH=y
CONFIG_LIBCURL_THREADED_RESOLVER=y
CONFIG_LIBCURL_LIBIDN2=y
CONFIG_LIBCURL_ZLIB=y
CONFIG_LIBCURL_ZSTD=y
CONFIG_LIBCURL_WEBSOCKETS=y

# Administration, diagnostics, storage, and WireGuard
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_mtr-nojson=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# Keep optional full-profile daemons closed until explicitly configured.
CONFIG_PACKAGE_sbe1v1k-full-defaults=y
