CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq95xx=y
CONFIG_TARGET_qualcommbe_ipq95xx_DEVICE_askey_sbe1v1k=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# This private target and the source-only PassWall feeds have no binary
# repositories on downloads.openwrt.org.
# CONFIG_TARGET_REPOSITORY is not set
# CONFIG_FEED_passwall_packages is not set
# CONFIG_FEED_passwall_luci is not set

# Do not build the host-side GDB toolchain unless a developer explicitly asks
# for it; it is not installed in the image and adds substantial cold-build time.
# CONFIG_GDB is not set
